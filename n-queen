class Solution:
    def solveNQueens(self, n: int) -> List[List[str]]:
        board =["."*n]*n
        ans =[]
        def canPut(board : list[str], r : int, c: int)-> bool:
            for i in range(c)
                if board [i][c]=='Q': return True
            i,j = r-1, c-1
            while i>0 and j<lrn(board):
                if board[i][j]== 'Q': return False
            return True




        def nQueen(n : int, board: list[str], r: int ) -> bool:
            if r == n:

                print(board)
                nb=(board)
                ans.append(nb)
                return False
            for i in range(n):
                cp = canPut (board, r, i)
                if cp:
                    board[r] = board[r][0:i] + 'Q' + board[r][i+1:n]
                    if nQueen(n, r+1): return True
                    board[r] = board[r][0:i] + '.' + board[r][i+1:]
            return False
        nQueen(n, 0)
        return ans
